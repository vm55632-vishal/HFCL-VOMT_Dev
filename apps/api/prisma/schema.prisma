// VOP data model — Phase 0 base (identity, sessions, IdP config, append-only audit).
// Phase 1 uses registration/approval + delegation. Vendor/workflow/document models arrive
// in Phases 2–4. IDs exposed in URLs are ULIDs (char(26)); see ADR-0003.
// The audit_log table is append-only + hash-chained (ADR-0005); a migration revokes
// UPDATE/DELETE from the app role and adds a guard trigger.

generator client {
  provider        = "prisma-client-js"
  // native = local dev; debian target = the distroless runtime image.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  // Lets a query load relations with SQL joins (relationLoadStrategy: 'join') in ONE round trip
  // instead of one query per relation — significant against a remote database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the transaction pooler (pgbouncer) for resilient pooling under concurrency.
  url       = env("DATABASE_URL")
  // Migrations / db push need a direct (session-pooler) connection.
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthMethod {
  OIDC
  SAML
  LOCAL
  VENDOR_OTP
  SUPABASE
}

enum RegistrationStatus {
  PENDING
  INFO_REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  ESCALATED
}

enum IdpProtocol {
  OIDC
  SAML
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentStatus {
  CLEAN
  INFECTED
  QUARANTINED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model Role {
  id          String   @id @db.Char(26)
  key         String   @unique
  label       String
  description String   @default("")
  builtIn     Boolean  @default(false)
  permissions String[] // resource:action strings
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  users       User[]           @relation("UserRoles")
  entityRoles UserEntityRole[]

  @@map("roles")
}

model User {
  id                 String     @id @db.Char(26)
  email              String     @unique
  name               String
  employeeId         String?    @map("employee_id")
  department         String?
  designation        String?
  status             UserStatus @default(PENDING_APPROVAL)
  authMethod         AuthMethod @default(OIDC) @map("auth_method")
  externalSubject    String?    @map("external_subject") // IdP `sub`
  supabaseUserId     String?    @unique @map("supabase_user_id") @db.Uuid // Supabase auth.users id
  managerId          String?    @map("manager_id") @db.Char(26)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  pwSalt             String?    @map("pw_salt")
  pwHash             String?    @map("pw_hash")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  manager     User?            @relation("Manager", fields: [managerId], references: [id])
  reports     User[]           @relation("Manager")
  roles       Role[]           @relation("UserRoles")
  entityRoles UserEntityRole[]

  sessions             Session[]
  registrationRequests RegistrationRequest[] @relation("Requester")
  decidedRequests      RegistrationRequest[] @relation("Decider")
  delegationsFrom      Delegation[]          @relation("DelegateFrom")
  delegationsTo        Delegation[]          @relation("DelegateTo")

  @@index([managerId])
  @@index([status])
  @@map("users")
}

model Session {
  id                String    @id @db.Char(26)
  userId            String    @map("user_id") @db.Char(26)
  tokenHash         String    @unique @map("token_hash")
  ip                String?
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model IdpConfig {
  id            String      @id @db.Char(26)
  name          String
  protocol      IdpProtocol
  issuer        String?
  clientId      String?     @map("client_id")
  metadataUrl   String?     @map("metadata_url")
  claimMappings Json        @default("{}") @map("claim_mappings")
  enabled       Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  claimRoleMappings ClaimRoleMapping[]

  @@map("idp_config")
}

model ClaimRoleMapping {
  id          String @id @db.Char(26)
  idpConfigId String @map("idp_config_id") @db.Char(26)
  claimType   String @map("claim_type") // e.g. "group", "role"
  claimValue  String @map("claim_value")
  roleKey     String @map("role_key")

  idpConfig IdpConfig @relation(fields: [idpConfigId], references: [id], onDelete: Cascade)

  @@unique([idpConfigId, claimType, claimValue, roleKey])
  @@map("claim_role_mapping")
}

model RegistrationRequest {
  id             String             @id @db.Char(26)
  userId         String             @map("user_id") @db.Char(26)
  requestedRoles String[]           @map("requested_roles")
  justification  String
  status         RegistrationStatus @default(PENDING)
  managerId      String?            @map("manager_id") @db.Char(26)
  decidedById    String?            @map("decided_by_id") @db.Char(26)
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?            @map("decision_note")
  expiresAt      DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User    @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("Decider", fields: [decidedById], references: [id])
  entityId  String? @map("entity_id") @db.Char(26)
  entity    Entity? @relation(fields: [entityId], references: [id])

  @@index([status])
  @@map("registration_request")
}

model Delegation {
  id         String   @id @db.Char(26)
  fromUserId String   @map("from_user_id") @db.Char(26)
  toUserId   String   @map("to_user_id") @db.Char(26)
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fromUser User @relation("DelegateFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DelegateTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("delegation")
}

/// Append-only, hash-chained audit trail (ADR-0005). Ordered by monotonic `seq`.
/// The application DB role has INSERT/SELECT only; a trigger rejects UPDATE/DELETE.
model AuditLog {
  seq           BigInt       @id @default(autoincrement())
  id            String       @unique @db.Char(26) // external reference
  at            DateTime     @default(now()) @db.Timestamptz(6)
  actorId       String?      @map("actor_id")
  actorRole     String?      @map("actor_role")
  ip            String?
  userAgent     String?      @map("user_agent")
  action        String
  entityType    String?      @map("entity_type")
  entityId      String?      @map("entity_id")
  outcome       AuditOutcome @default(SUCCESS)
  detail        Json?
  correlationId String?      @map("correlation_id")
  prevHash      String       @map("prev_hash")
  rowHash       String       @unique @map("row_hash")

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([at])
  @@map("audit_log")
}

/// Configurable vendor category (master data). Drives required docs/validations and workflow.
model VendorCategory {
  id                   String   @id @db.Char(26)
  key                  String   @unique
  name                 String
  description          String   @default("")
  sortOrder            Int      @default(100) @map("sort_order")
  active               Boolean  @default(true)
  enhancedDueDiligence Boolean  @default(false) @map("enhanced_due_diligence")
  requiredDocuments    String[] @map("required_documents")
  requiredValidations  String[] @map("required_validations")
  workflowKey          String   @map("workflow_key")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subCategories VendorSubCategory[]

  @@index([active, sortOrder])
  @@map("vendor_category")
}

/// Externally-managed auth token for a third-party integration (e.g. the EY Nexus PAN API).
/// The token is generated out-of-band and stored here; the app reads it to call the provider.
model IntegrationToken {
  provider  String    @id
  token     String
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("integration_token")
}

/// Runtime-editable object-storage configuration (single row, id = "default"). Lets an admin point
/// the platform at a different bucket/provider (e.g. Cloudflare R2) without a redeploy. Any field
/// left null falls back to the VOP_STORAGE_* env config. Security: the secret access key is
/// envelope-encrypted at rest (`secret_key_enc`), never stored in plaintext, and masked on read.
model StorageConfig {
  id           String   @id @default("default")
  driver       String
  endpoint     String
  bucket       String
  region       String   @default("auto")
  accessKeyId  String?  @map("access_key_id")
  secretKeyEnc String?  @map("secret_key_enc")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById  String?  @map("updated_by_id") @db.Char(26)

  @@map("storage_config")
}

/// Cached third-party verification responses (EY PAN/GST/bank), to avoid repeat external API
/// calls for the same identifier within the same scope and day. Security: the payload is
/// envelope-encrypted at rest (PII — names, Aadhaar status, bank holder, address), and the
/// identifier is stored only as a blind-index HMAC, never in plaintext. Entries expire at the
/// end of the (IST) day and are scoped per requester/case so one user's lookup can't serve another.
model VerificationCache {
  id         String   @id @db.Char(26)
  scope      String
  kind       String
  keyHash    String   @map("key_hash")
  day        String   @db.Char(10)
  payloadEnc String   @map("payload_enc")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([scope, kind, keyHash, day])
  @@index([expiresAt])
  @@map("verification_cache")
}

/// A sub-category (VOMT account group) under a vendor category. Picked on the intake form.
model VendorSubCategory {
  id          String   @id @db.Char(26)
  key         String   @unique
  name        String
  categoryKey String   @map("category_key")
  sortOrder   Int      @default(100) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category VendorCategory @relation(fields: [categoryKey], references: [key], onDelete: Cascade)

  @@index([categoryKey, active, sortOrder])
  @@map("vendor_sub_category")
}

/// A versioned workflow definition. In-flight cases keep executing the version they started on;
/// publishing creates a new version rather than mutating a published one.
model WorkflowDefinition {
  id             String         @id @db.Char(26)
  key            String
  name           String
  version        Int
  status         WorkflowStatus @default(DRAFT)
  rejectStageKey String         @default("rejected") @map("reject_stage_key")
  createdById    String?        @map("created_by_id") @db.Char(26)
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  stages WorkflowStage[]

  @@unique([key, version])
  @@index([key, status])
  @@map("workflow_definition")
}

model WorkflowStage {
  id              String   @id @db.Char(26)
  workflowId      String   @map("workflow_id") @db.Char(26)
  key             String
  name            String
  shortName       String   @map("short_name")
  order           Int
  ownerRole       String?  @map("owner_role")
  slaBusinessDays Int      @default(0) @map("sla_business_days")
  terminal        Boolean  @default(false)
  applicableTiers String[] @map("applicable_tiers")
  evidenceGate    Boolean  @default(false) @map("evidence_gate")

  workflow    WorkflowDefinition        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  permissions WorkflowStagePermission[]

  @@unique([workflowId, key])
  @@index([workflowId, order])
  @@map("workflow_stage")
}

/// Stage-level permissions — which role may view, edit fields, approve, reject, send back or
/// reassign at a stage. Data-driven (prompt §3.1); enforced server-side.
model WorkflowStagePermission {
  id            String  @id @db.Char(26)
  stageId       String  @map("stage_id") @db.Char(26)
  roleKey       String  @map("role_key")
  canView       Boolean @default(true) @map("can_view")
  canEditFields Boolean @default(false) @map("can_edit_fields")
  canApprove    Boolean @default(false) @map("can_approve")
  canReject     Boolean @default(false) @map("can_reject")
  canSendBack   Boolean @default(false) @map("can_send_back")
  canReassign   Boolean @default(false) @map("can_reassign")

  stage WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, roleKey])
  @@map("workflow_stage_permission")
}

/// A vendor onboarding case — the request that flows through a workflow. Sensitive identifiers
/// (PAN, bank account) are stored encrypted (envelope) with a blind index for duplicate detection;
/// the tier and checklist are computed server-side. In-flight cases keep their workflow version.
model Case {
  id              String  @id @db.Char(26)
  ref             String  @unique
  categoryKey     String  @map("category_key")
  subCategoryKey  String? @map("sub_category_key")
  workflowKey     String  @map("workflow_key")
  workflowVersion Int     @map("workflow_version")

  // workflow state
  stage        String
  assigneeId   String?   @map("assignee_id") @db.Char(26)
  dueAt        DateTime? @map("due_at") @db.Timestamptz(6)
  onHold       Boolean   @default(false) @map("on_hold")
  tier         String    @default("low")
  riskScore    Int       @default(0) @map("risk_score")
  vendorCode   String?   @map("vendor_code")
  vendorStatus String    @default("ACTIVE") @map("vendor_status")
  blockReason  String?   @map("block_reason")
  erpPushedAt  DateTime? @map("erp_pushed_at") @db.Timestamptz(6)
  erpRef       String?   @map("erp_ref")

  // ownership / timestamps
  createdById     String    @map("created_by_id") @db.Char(26)
  lastUpdatedById String?   @map("last_updated_by_id") @db.Char(26)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // information-security routing state (the questionnaire answers live on case_general)
  infosecRequired    Boolean   @default(false) @map("infosec_required")
  infosecClearedAt   DateTime? @map("infosec_cleared_at") @db.Timestamptz(6)
  infosecClearedById String?   @map("infosec_cleared_by_id") @db.Char(26)

  checklist    CaseChecklistItem[]
  comments     CaseComment[]
  activity     CaseActivity[]
  documents    Document[]
  verification CaseVerification?

  // normalized reporting structure (all keyed by case id)
  general          CaseGeneral?
  draftStage       CaseDraft?
  infosecStage     CaseInfosec?
  fcuStage         CaseFcu?
  operationStage   CaseOperation?
  sapStage         CaseSap?
  legalStage       CaseLegal?
  responses        CaseVerificationResponse[]
  partners         PartnerDetail[]
  vendorReferences VendorReference[]
  rcLimits         RcLimit[]
  teamStructure    CaseTeamStructure?
  kycChecks        CaseKycCheck[]

  // The proposer this case was raised for, when someone else raised it (createdById is the raiser).
  // Both are treated as the case owner.
  onBehalfOfId String? @map("on_behalf_of_id") @db.Char(26)

  // ADR-0008: the group company this case belongs to
  entityId String @map("entity_id") @db.Char(26)
  entity   Entity @relation(fields: [entityId], references: [id])

  @@index([stage])
  @@index([createdById])
  @@index([assigneeId])
  @@index([infosecRequired])
  @@index([entityId, createdAt])
  @@index([onBehalfOfId])
  @@map("case")
}

model CaseChecklistItem {
  id       String    @id @db.Char(26)
  caseId   String    @map("case_id") @db.Char(26)
  itemId   String    @map("item_id")
  label    String
  role     String?
  done     Boolean   @default(false)
  doneById String?   @map("done_by_id") @db.Char(26)
  doneAt   DateTime? @map("done_at") @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, itemId])
  @@map("case_checklist_item")
}

model CaseComment {
  id       String   @id @db.Char(26)
  caseId   String   @map("case_id") @db.Char(26)
  authorId String   @map("author_id") @db.Char(26)
  body     String
  at       DateTime @default(now()) @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_comment")
}

model CaseActivity {
  id        String   @id @db.Char(26)
  caseId    String   @map("case_id") @db.Char(26)
  at        DateTime @default(now()) @db.Timestamptz(6)
  actorId   String?  @map("actor_id") @db.Char(26)
  action    String
  fromStage String?  @map("from_stage")
  toStage   String?  @map("to_stage")
  note      String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, at])
  @@map("case_activity")
}

/// An uploaded document on a case. The file is stored via the StorageProvider under an opaque
/// key (never the user filename); only metadata lives here. Every upload is magic-byte validated
/// and malware-scanned; infected files are never stored. SHA-256 gives integrity.
model Document {
  id            String         @id @db.Char(26)
  caseId        String         @map("case_id") @db.Char(26)
  docType       String         @map("doc_type")
  filename      String // original name, for display only
  storageKey    String         @unique @map("storage_key")
  contentType   String         @map("content_type")
  fileType      String         @map("file_type")
  sizeBytes     Int            @map("size_bytes")
  sha256        String
  status        DocumentStatus @default(QUARANTINED)
  scanSignature String?        @map("scan_signature")
  version       Int            @default(1)
  expiryDate    DateTime?      @map("expiry_date") @db.Date
  uploadedById  String         @map("uploaded_by_id") @db.Char(26)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([expiryDate])
  @@map("document")
}

/// Statutory verification results for a case (1:1): what the PAN/GST/bank/MCA/Udyam providers
/// returned, the name-match score, offline cross-checks, and the red flags raised. reviewRequired
/// routes the case into the manual review queue. Raw provider payloads are referenced, not stored
/// in the clear (rawRef). Recomputed on each run.
model CaseVerification {
  id                String   @id @db.Char(26)
  caseId            String   @unique @map("case_id") @db.Char(26)
  panStatus         String?  @map("pan_status")
  gstStatus         String?  @map("gst_status")
  bankStatus        String?  @map("bank_status")
  mcaStatus         String?  @map("mca_status")
  udyamStatus       String?  @map("udyam_status")
  gstLegalName      String?  @map("gst_legal_name")
  bankNameOnRecord  String?  @map("bank_name_on_record")
  taxpayerType      String?  @map("taxpayer_type")
  incorporationDate String?  @map("incorporation_date")
  nameMatchScore    Float?   @map("name_match_score")
  nameMatchVerdict  String?  @map("name_match_verdict")
  crossChecks       Json     @default("[]") @map("cross_checks")
  redFlags          Json     @default("[]") @map("red_flags")
  reviewRequired    Boolean  @default(false) @map("review_required")
  rawRef            String?  @map("raw_ref")
  verifiedAt        DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([reviewRequired])
  @@map("case_verification")
}

/// In-app notification for a user (email is sent separately via EmailProvider). No sensitive data.
model Notification {
  id        String   @id @db.Char(26)
  userId    String   @map("user_id") @db.Char(26)
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, read])
  @@map("notification")
}

/// Vendor master detail for a case (1:1 with `case`). The `case` table holds tracking/workflow
/// state only; all vendor-entered and registry-derived detail lives here, keyed by case id.
/// Sensitive identifiers keep the same protection as before: PAN / bank account / signatory PAN
/// are envelope-encrypted, with blind-index HMACs for duplicate detection (ADR-0006).
model CaseGeneral {
  id     String @id @db.Char(26)
  caseId String @unique @map("case_id") @db.Char(26)

  // vendor identity (non-sensitive)
  legalName       String  @map("legal_name")
  tradeName       String? @map("trade_name")
  businessAddress String? @map("business_address")

  // business single point of contact (SPOC)
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // authorized signatory — PAN encrypted + blind-indexed; the rest stored plainly
  signatoryName          String? @map("signatory_name")
  signatoryEmail         String? @map("signatory_email")
  signatoryMobile        String? @map("signatory_mobile")
  signatoryPanEnc        String? @map("signatory_pan_enc")
  signatoryPanBlindIndex String? @map("signatory_pan_blind_index")

  // statutory ids — PAN & bank account encrypted; GSTIN/IFSC plain, blind-indexed for dedup
  panEnc          String? @map("pan_enc")
  panBlindIndex   String? @map("pan_blind_index")
  gstin           String? @map("gstin")
  gstinBlindIndex String? @map("gstin_blind_index")
  ifsc            String? @map("ifsc")
  bankName        String? @map("bank_name")
  branch          String? @map("branch")
  bankAccountEnc  String? @map("bank_account_enc")
  bankBlindIndex  String? @map("bank_blind_index")

  // engagement
  businessUnit    String? @map("business_unit")
  costCentre      String? @map("cost_centre")
  spend           Int     @default(0)
  contractMonths  Int?    @map("contract_months")
  natureOfService String? @map("nature_of_service")
  justification   String  @default("")
  coiDeclared     Boolean @default(false) @map("coi_declared")
  coiDetails      String? @map("coi_details")

  // risk inputs
  dataAccess     String? @map("data_access")
  systemAccess   String? @map("system_access")
  subcontract    String?
  delivery       String?
  screening      String?
  conflict       String?
  litigation     String?
  insurance      String?
  certifications String?

  // information-security questionnaire answers (routing decision lives on `case`)
  isecItHardware    Boolean @default(false) @map("isec_it_hardware")
  isecItSoftware    Boolean @default(false) @map("isec_it_software")
  isecAccessSystem  Boolean @default(false) @map("isec_access_system")
  isecAccessNetwork Boolean @default(false) @map("isec_access_network")
  isecAccessApps    Boolean @default(false) @map("isec_access_apps")
  isecAccessPii     Boolean @default(false) @map("isec_access_pii")

  // registry-derived (populated by verification)
  panStatus         String? @map("pan_status")
  gstStatus         String? @map("gst_status")
  nameMatch         String? @map("name_match")
  taxpayerType      String? @map("taxpayer_type")
  legalNameOnRecord String? @map("legal_name_on_record")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([panBlindIndex])
  @@index([gstinBlindIndex])
  @@index([bankBlindIndex])
  @@index([signatoryPanBlindIndex])
  @@map("case_general")
}

/// Per-stage record (1:1 with `case`). One table per workflow stage; each carries common
/// tracking columns plus a `data` JSON for stage-specific fields (promote to named columns on
/// request). A row is created/updated as the case enters/leaves the stage.
model CaseDraft {
  id           String    @id @db.Char(26)
  caseId       String    @unique @map("case_id") @db.Char(26)
  status       String    @default("pending")
  decision     String?
  remark       String?
  actionedById String?   @map("actioned_by_id") @db.Char(26)
  enteredAt    DateTime? @map("entered_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  data         Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_draft")
}

