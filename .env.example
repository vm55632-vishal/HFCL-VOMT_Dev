# =============================================================================
# VOP — root example environment. Copy to `.env` (git-ignored) and fill in.
# The compose stack (infra/docker/docker-compose.yml) reads these too.
# NEVER commit a real .env. All values here are placeholders.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
VOP_API_PORT=3000
VOP_WEB_PORT=3001
VOP_PUBLIC_URL=http://localhost:3001
VOP_API_URL=http://localhost:3000

# --- Data residency / retention (India-only per client) ---
VOP_DATA_REGION=in
VOP_AUDIT_RETENTION_DAYS=2920   # 8 years

# --- Database (PostgreSQL 15) ---
DATABASE_URL=postgresql://vop:changeme@localhost:5432/vop?schema=public
# Supabase Postgres (remote): use the SESSION pooler (port 5432), not the transaction pooler
# (6543). This API is a long-running server; the transaction pooler adds ~0.5s to EVERY query
# (measured 650ms vs 130ms), which made a case submit take a minute. Cap the Prisma pool so it
# stays inside the pooler's client limit (default pool_size 15):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=8&pool_timeout=30
# Use the transaction pooler (6543, ?pgbouncer=true) only for serverless deployments.
# App runtime uses a least-privilege role (no UPDATE/DELETE on audit_log).
VOP_DB_APP_USER=vop_app
VOP_DB_APP_PASSWORD=changeme

# --- Redis (queues / rate-limit / session store) ---
REDIS_URL=redis://localhost:6379

# --- Provider selection (adapter chosen by these values) ---
VOP_STORAGE_DRIVER=minio          # minio | s3 | r2 | azure-blob | gcs | local
VOP_SECRETS_DRIVER=env            # env | vault | azure-kv | aws-sm | gcp-sm
VOP_EMAIL_DRIVER=smtp             # smtp | sendgrid | azure-acs | aws-ses
VOP_SMS_DRIVER=mock               # mock | (provider)
VOP_QUEUE_DRIVER=redis            # redis | azure-servicebus | aws-sqs | gcp-pubsub
VOP_SCAN_DRIVER=clamav            # clamav | (cloud-native)
VOP_KEY_DRIVER=local              # local | vault-transit | azure-kv | aws-kms | gcp-kms
VOP_VERIFICATION_DRIVER=mock      # mock | (aggregator, once configured)

# --- Object storage (MinIO defaults for on-prem/dev) ---
VOP_STORAGE_ENDPOINT=http://localhost:9000
VOP_STORAGE_BUCKET=vop-documents
VOP_STORAGE_ACCESS_KEY=changeme
VOP_STORAGE_SECRET_KEY=changeme
VOP_STORAGE_REGION=us-east-1      # MinIO ignores region; required by S3 SDK
#
# --- Cloudflare R2 (set VOP_STORAGE_DRIVER=r2) ---
# Create an R2 bucket + an R2 API token (S3 Auth) in the Cloudflare dashboard, then:
#   VOP_STORAGE_DRIVER=r2
#   VOP_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   VOP_STORAGE_BUCKET=vop-documents
#   VOP_STORAGE_ACCESS_KEY=<R2 access key id>
#   VOP_STORAGE_SECRET_KEY=<R2 secret access key>
#   VOP_STORAGE_REGION=auto

# --- Secrets: HashiCorp Vault (on-prem) ---
VOP_VAULT_ADDR=http://localhost:8200
VOP_VAULT_TOKEN=changeme

# --- Field encryption (envelope) ---
# Dev only: a local master key. In prod this comes from KeyProvider (Vault/KMS).
VOP_MASTER_KEY=changeme-32-byte-base64-key-goes-here==
VOP_BLIND_INDEX_KEY=changeme-blind-index-hmac-key

# --- Email (Mailpit in dev) ---
VOP_SMTP_HOST=localhost
VOP_SMTP_PORT=1025
VOP_SMTP_SECURE=false
VOP_SMTP_USER=
VOP_SMTP_PASSWORD=
VOP_EMAIL_FROM=no-reply@vop.local

# --- Malware scanning (ClamAV) ---
VOP_CLAMAV_HOST=localhost
VOP_CLAMAV_PORT=3310

# --- Sessions ---
VOP_SESSION_COOKIE_NAME=vop_sid
VOP_SESSION_IDLE_MINUTES=15
VOP_SESSION_ABSOLUTE_HOURS=8
VOP_COOKIE_SECURE=false           # true behind TLS in prod
# Cookie SameSite: lax (default) | strict | none. Use `none` when the web app is on a different
# site than the API (e.g. a Vercel domain -> this API host); `none` requires VOP_COOKIE_SECURE=true.
VOP_COOKIE_SAMESITE=lax

# --- Identity (OIDC via Keycloak broker in dev; Entra ID in prod) ---
VOP_OIDC_ISSUER=http://localhost:8080/realms/vop
VOP_OIDC_CLIENT_ID=vop-api
VOP_OIDC_CLIENT_SECRET=changeme
VOP_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
# SAML (optional second IdP)
VOP_SAML_ENABLED=false
VOP_SAML_ENTRY_POINT=
VOP_SAML_ISSUER=vop
VOP_SAML_CERT=

# --- Break-glass local admin (disabled by default; MFA enforced) ---
VOP_LOCAL_LOGIN_ENABLED=false

# --- Observability ---
VOP_LOG_LEVEL=info
VOP_OTEL_ENABLED=false
VOP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- CORS (allow-list, comma-separated; never *) ---
# Add your deployed web origin(s), e.g. https://your-app.vercel.app,https://vendor.your-domain.com
VOP_CORS_ORIGINS=http://localhost:3001
# Also accept any https://*.vercel.app origin (Vercel preview deployments). Leave false in prod
# unless you intend to accept all preview URLs.
VOP_CORS_ALLOW_VERCEL_PREVIEWS=false

# --- Authentication driver ---
# `session` = built-in cookie sessions (local/OIDC/SAML). `supabase` = verify Supabase JWTs.
VOP_AUTH_DRIVER=session
# Supabase (required when VOP_AUTH_DRIVER=supabase). Point DATABASE_URL at Supabase Postgres too.
VOP_SUPABASE_URL=https://YOUR-REF.supabase.co
VOP_SUPABASE_ANON_KEY=
VOP_SUPABASE_JWT_SECRET=
VOP_SUPABASE_SERVICE_ROLE_KEY=
# One-off: initial password for the demo Supabase users (seed-supabase-users.ts)
VOP_SEED_SUPABASE_PASSWORD=

# --- PAN verification (EY Nexus CVR-API). Credentials are secrets; set in .env, never commit. ---
VOP_PAN_VERIFY_ENABLED=false
VOP_EY_NEXUS_BASE_URL=https://nexus-in.ey.com
VOP_EY_NEXUS_USERNAME=
VOP_EY_NEXUS_PASSWORD=
VOP_EY_PAN_SERVICE_TYPE_ID=66
